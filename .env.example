# 로컬 MySQL (docker-compose.yml에서 사용)
MYSQL_ROOT_PASSWORD=localroot
MYSQL_DATABASE=daycare
MYSQL_USER=daycare
MYSQL_PASSWORD=localpass

# 백엔드 (Phase 2 이후 사용)
DB_URL=jdbc:mysql://localhost:3306/daycare?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=daycare
DB_PASSWORD=localpass
JWT_SECRET=

# SOLAPI 문자 발송 (Phase 3)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SMS_FROM=
SMS_ADMIN_PHONE=
